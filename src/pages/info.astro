---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const title = 'Profil | Dhika Jalak Suren Bali';
const description = 'Profil UD. Dhika Jalak Suren Bali, informasi alamat, kontak WhatsApp, media sosial, dan lokasi penjual jalak suren di Dalung, Badung, Bali.';
---

<!doctype html>
<html lang="id">
	<head>
		<BaseHead title={title} description={description} />
	</head>
	<body>
		<Header />
		<main>
			<section class="profile">
				<img class="profile-image" src="/images/2026/11/22/IMG-20261121-WA0018.webp" alt="UD. Dhika Jalak Suren Bali" fetchpriority="high" />
				<h1>DHIKA JALAK SUREN BALI</h1>
				<div class="details">
					<div class="detail">
						<strong>Perizinan Berusaha</strong>
						<span>Sertifikat Standar 260226002661150002</span>
					</div>
					<div class="detail">
						<strong>Alamat</strong>
						<span>Jl. I Gusti Ngurah Gentuh No. 28, Dalung, Kecamatan Kuta Utara, Kabupaten Badung, Bali 80351.</span>
					</div>
					<div class="detail">
						<strong>Lokasi Google Maps</strong>
						<span><a href="https://maps.app.goo.gl/VNEjK7sAWpUQuBh47" target="_blank" rel="noopener noreferrer">UD.Dikha Jalak Suren Bali</a></span>
					</div>
					<div class="detail">
						<strong>WhatsApp</strong>
						<span><a href="https://wa.me/6287723457380?text=Halo%20UD.%20Dhika%20Jalak%20Suren%20Bali%2C%20saya%20ingin%20bertanya." target="_blank" rel="noopener noreferrer">0877-2345-7380</a></span>
					</div>
					<div class="detail">
						<strong>Facebook</strong>
						<span><a href="https://www.facebook.com/jalak.suren.bali" target="_blank" rel="noopener noreferrer">Jalak Suren Bali</a></span>
					</div>
					<div class="detail">
						<strong>TikTok</strong>
						<span><a href="https://www.tiktok.com/@dhika.jalak.suren.bali" target="_blank" rel="noopener noreferrer">Dhika Jalak Suren Bali</a></span>
					</div>
					<div class="detail">
						<strong>Instagram</strong>
						<span><a href="https://www.instagram.com/ud.dhikajalaksuren/" target="_blank" rel="noopener noreferrer">Dhika Jalak Suren Bali</a></span>
					</div>
					<div class="detail">
						<strong>Informasi Stok</strong>
						<span>Stok burung tidak selalu ready setiap saat. Untuk memastikan stok real time, harga terkini maupun harga grosir, silakan langsung hubungi admin via WhatsApp.</span>
					</div>
					<div class="detail">
						<strong>Wilayah Layanan</strong>
						<span>Wilayah Pulau Bali dan informasi mengenai pengiriman ke luar pulau melalui konfirmasi langsung.</span>
					</div>
				</div>

				<section class="map-section" aria-labelledby="map-title">
				<iframe 
                    src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3944.8228179339017!2d115.17124279999999!3d-8.6130034!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x2dd2393f368f27ff%3A0xdb3a815d133d8835!2sUD.Dikha%20Jalak%20Suren%20Bali!5e0!3m2!1sid!2sid!4v1795115424869!5m2!1sid!2sid" 
                    width="100%" 
                    height="450" 
                    style="border:0;" 
                    allowfullscreen="" 
                    loading="lazy" 
                    referrerpolicy="strict-origin-when-cross-origin">
                </iframe>
				</section>
			</section>
		</main>
		<Footer />
	</body>
</html>

<style>
	main {
		width: min(100% - 2rem, 900px);
		margin: 0 auto;
		padding: 2rem 0 3rem;
	}
	.profile-image {
		display: block;
		width: 100%;
		height: auto;
		max-height: 420px;
		object-fit: cover;
		object-position: center 0%;
		margin-bottom: 1.75rem;
		border-radius: 12px;
	}
	.eyebrow {
		margin: 0 0 .5rem;
		color: #159957;
		font-size: .8rem;
		font-weight: 800;
		letter-spacing: .12em;
	}
	h1 {
		margin: 0 0 1rem;
		font-size: clamp(1.7rem, 5vw, 2.4rem);
		line-height: 1.2;
        text-align: center;
}
	.details {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 1rem;
		margin-top: 2rem;
	}
	.detail {
		display: flex;
		flex-direction: column;
		gap: .35rem;
		padding: 1rem;
		background: #f5f8f6;
		border-radius: 10px;
		font-size: 19px;
		line-height: 1.6;
		overflow-wrap: anywhere;
	}
	.detail strong { color: #222222; }
	.detail a, .text-link {
		text-decoration: none;
	}

    .detail a:hover, .text-link:hover {
		text-decoration: underline;
		text-underline-offset: 3px;
	}

	.map-section iframe {
        margin-top: 2em;
        border-radius: 12px;
   }

	.text-link { display: inline-block; margin-top: .85rem; }
	.actions { margin-top: 2rem; text-align: center; }
	.contact-link {
		display: inline-block;
		padding: .85rem 1.4rem;
		border-radius: 999px;
		background: #159957;
		color: #fff;
		font-weight: 700;
		text-decoration: none;
	}
	.contact-link:hover { background: #117b47; }
	@media (max-width: 600px) {
		main { width: min(100% - 1rem, 900px); padding: 1rem 0 2rem; }
		.details { grid-template-columns: 1fr; }
		.profile { border-radius: 12px; }
	}
</style>

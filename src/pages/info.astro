---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const title = 'Profil | Dhika Jalak Suren Bali';
const description = 'Profil UD. Dhika Jalak Suren Bali, informasi alamat, kontak WhatsApp, media sosial, dan lokasi penjual jalak suren di Dalung, Badung, Bali.';
---

<!doctype html>
<html lang="id">
	<head>
		<BaseHead title={title} description={description} />
	</head>
	<body>
		<Header />
		<main>
			<section class="profile">
				<img class="profile-image" src="/dhika-jalak-suren-bali.webp" alt="UD. Dhika Jalak Suren Bali" fetchpriority="high" />
				<p class="eyebrow">TENTANG KAMI</p>
				<h1>UD. DHIKA JALAK SUREN BALI</h1>
				<p class="intro">
					Selamat datang di website UD. DHIKA JALAK SUREN BALI. Website ini menjadi tempat berbagi postingan foto burung dan informasi singkat. Untuk menanyakan ketersediaan, harga, serta informasi pengiriman, silakan hubungi kami secara langsung melalui WhatsApp.
				</p>

				<div class="details">
					<div class="detail">
						<strong>Alamat</strong>
						<span>Jl. I Gusti Ngurah Gentuh No. 28, Dalung, Kecamatan Kuta Utara, Kabupaten Badung, Bali 80351.</span>
					</div>
					<div class="detail">
						<strong>WhatsApp</strong>
						<span><a href="https://wa.me/6287723457380?text=Halo%20UD.%20Dhika%20Jalak%20Suren%20Bali%2C%20saya%20ingin%20bertanya." target="_blank" rel="noopener noreferrer">0877-2345-7380</a></span>
					</div>
					<div class="detail">
						<strong>Facebook</strong>
						<span><a href="https://www.facebook.com/jalak.suren.bali" target="_blank" rel="noopener noreferrer">facebook.com/jalak.suren.bali</a></span>
					</div>
					<div class="detail">
						<strong>TikTok</strong>
						<span><a href="https://www.tiktok.com/@dhika.jalak.suren.bali" target="_blank" rel="noopener noreferrer">tiktok.com/@dhika.jalak.suren.bali</a></span>
					</div>
					<div class="detail">
						<strong>Instagram</strong>
						<span><a href="https://www.instagram.com/ud.dhikajalaksuren/" target="_blank" rel="noopener noreferrer">instagram.com/ud.dhikajalaksuren</a></span>
					</div>
					<div class="detail">
						<strong>Wilayah layanan</strong>
						<span>Bali dan informasi pengiriman ke luar pulau melalui konfirmasi langsung.</span>
					</div>
					<div class="detail">
						<strong>Informasi stok</strong>
						<span>Stok dan harga dapat berubah. Silakan konfirmasi sebelum melakukan transaksi.</span>
					</div>
				</div>

				<section class="map-section" aria-labelledby="map-title">
					<h2 id="map-title">Lokasi DHIKA JS BALI</h2>
					<p>Jl. I Gusti Ngurah Gentuh No. 28, Dalung, Kecamatan Kuta Utara, Kabupaten Badung, Bali 80351.</p>
					<div class="map-frame">
						<iframe
							title="Peta lokasi DHIKA JS BALI di Dalung, Bali"
							src="https://www.google.com/maps?q=Jl.%20I%20Gusti%20Ngurah%20Gentuh%20No.%2028%2C%20Dalung%2C%20Kuta%20Utara%2C%20Badung%2C%20Bali%2080351&output=embed"
							width="100%"
							height="360"
							style="border:0"
							loading="lazy"
							referrerpolicy="no-referrer-when-downgrade"
							allowfullscreen>
						</iframe>
					</div>
					<a class="text-link" href="https://maps.app.goo.gl/FwEpp2eYaPWoBoYB6?g_st=ac" target="_blank" rel="noopener noreferrer">Buka petunjuk arah di Google Maps</a>
				</section>

				<div class="actions">
					<a class="contact-link" href="https://wa.me/6287723457380?text=Halo%20UD.%20Dhika%20Jalak%20Suren%20Bali%2C%20saya%20ingin%20bertanya." target="_blank" rel="noopener noreferrer">Hubungi via WhatsApp</a>
				</div>
			</section>
		</main>
		<Footer />
	</body>
</html>

<style>
	main {
		width: min(100% - 2rem, 900px);
		margin: 0 auto;
		padding: 2rem 0 3rem;
	}
	.profile-image {
		display: block;
		width: 100%;
		height: auto;
		max-height: 420px;
		object-fit: cover;
		object-position: center;
		margin-bottom: 1.75rem;
		border-radius: 12px;
	}
	.profile {
		padding: clamp(1.25rem, 4vw, 2.5rem);
		background: #fff;
		border-radius: 16px;
		box-shadow: var(--box-shadow);
	}
	.eyebrow {
		margin: 0 0 .5rem;
		color: #159957;
		font-size: .8rem;
		font-weight: 800;
		letter-spacing: .12em;
	}
	h1 {
		margin: 0 0 1rem;
		font-size: clamp(1.7rem, 5vw, 2.4rem);
		line-height: 1.2;
	}
	.intro {
		margin: 0;
		line-height: 1.8;
	}
	.details {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 1rem;
		margin-top: 2rem;
	}
	.detail {
		display: flex;
		flex-direction: column;
		gap: .35rem;
		padding: 1rem;
		background: #f5f8f6;
		border-radius: 10px;
		font-size: .95rem;
		line-height: 1.6;
		overflow-wrap: anywhere;
	}
	.detail strong { color: #155799; }
	.detail a, .text-link {
		text-decoration: none;
	}

    .detail a:hover, .text-link:hover {
		text-decoration: underline;
		text-underline-offset: 3px;
	}

	.map-section { margin-top: 2.5rem; }
	.map-section h2 { margin-bottom: .5rem; }
	.map-section p { line-height: 1.7; }
	.map-frame {
		overflow: hidden;
		border: 1px solid #dce5df;
		border-radius: 14px;
	}
	.map-frame iframe {
		display: block;
		width: 100%;
		min-height: 300px;
	}
	.text-link { display: inline-block; margin-top: .85rem; }
	.actions { margin-top: 2rem; text-align: center; }
	.contact-link {
		display: inline-block;
		padding: .85rem 1.4rem;
		border-radius: 999px;
		background: #159957;
		color: #fff;
		font-weight: 700;
		text-decoration: none;
	}
	.contact-link:hover { background: #117b47; }
	@media (max-width: 600px) {
		main { width: min(100% - 1rem, 900px); padding: 1rem 0 2rem; }
		.details { grid-template-columns: 1fr; }
		.profile { border-radius: 12px; }
	}
</style>

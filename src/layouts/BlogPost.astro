---
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';

type Props = CollectionEntry<'blog'>['data'];

const { title, description, pubDate, updatedDate, heroImage } = Astro.props;
---

<html lang="id-ID">
	<head>
		<BaseHead
			title={title}
			description={description}
			image={heroImage || '/blog-placeholder-2.jpg'}
			type="article"
			publishedTime={pubDate}
			modifiedTime={updatedDate}
		/>
		<style>
			main {
				width: calc(100% - 2em);
				max-width: 100%;
				margin: 0;
			}
			.hero-image {
				width: 100%;
			}
			.hero-image img {
				display: block;
				margin: 0 auto;
				border-radius: 12px;
				box-shadow: var(--box-shadow);
			}
			.prose {
				width: 720px;
				max-width: 100%;
				margin: auto;
				padding: 1em 0;
				color: rgb(var(--gray-dark));
			}
			.title {
				margin-bottom: 1em;
				padding: 1em 0;
				text-align: center;
				line-height: 1;
			}
			.title h1 {
				margin: 0 0 0.5em 0;
			}
			.date {
				margin-bottom: 0.5em;
				color: rgb(var(--gray));
			}
			.last-updated-on {
				font-style: italic;
			}

			.article-info {
				margin-top: 3em;
				padding: 1.25rem;
				border: 1px solid #d9e4df;
				border-radius: 10px;
				background: #f5faf7;
				color: #263b31;
				font-size: 0.96rem;
				line-height: 1.65;
			}
			.article-info h2 {
				margin: 0 0 0.65rem;
				color: #155c3b;
				font-size: 1.15rem;
			}
			.article-info p {
				margin: 0 0 0.85rem;
			}
			.article-info p:last-child {
				margin-bottom: 0;
			}
			.article-info a {
				font-weight: 700;
				text-decoration: none;
				text-underline-offset: 2px;
			}

            .article-info a:hover {
				text-decoration: underline;
				text-underline-offset: 2px;
			}

			.article-info .info-label {
				display: block;
				margin-bottom: 0.15rem;
				color: #52665b;
				font-size: 0.78rem;
				font-weight: 800;
				letter-spacing: 0.045em;
				text-transform: uppercase;
			}
			@media (max-width: 600px) {
				.article-info {
					padding: 1rem;
					font-size: 1.1rem;
				}
			}
		</style>
	</head>

	<body>
		<Header />
		<main>
			<article>
				<div class="hero-image">
					{heroImage && <img width={1020} height={510} src={heroImage} alt="" />}
				</div>
				<div class="prose">
					<div class="title">
						<div class="date">
							<FormattedDate date={pubDate} />
							{
								updatedDate && (
									<div class="last-updated-on">
										Last updated on <FormattedDate date={updatedDate} />
									</div>
								)
							}
						</div>
						<h1>{title}</h1>
						<hr />
					</div>
					<slot />

					<aside class="article-info" aria-labelledby="article-info-title">
						<h2 id="article-info-title">Informasi Penting</h2>
						<p>Stok burung tidak selalu ready setiap saat. Harap perhatikan tanggal postingan untuk estimasi ketersediaan.</p>
						<p>Untuk memastikan stok real time, harga terkini maupun harga grosir, silakan langsung hubungi admin via WhatsApp <a href="https://wa.me/6287723457380" target="_blank" rel="noopener noreferrer">0877-2345-7380</a>.</p>
						<p>
							<span class="info-label">Alamat &amp; Lokasi (Google Maps)</span>
							<a href="https://maps.app.goo.gl/VNEjK7sAWpUQuBh47" target="_blank" rel="noopener noreferrer">Jl. I Gusti Ngurah Gentuh No. 28, Dalung, Kecamatan Kuta Utara, Kabupaten Badung, Bali 80351.</a>
						</p>
						<p>Silakan kunjungi <a href="https://demo.dhikajsbali.com/info/">halaman informasi</a> untuk detail ketentuan pembayaran, pengiriman, maupun informasi lainnya.</p>
					</aside>
				</div>
			</article>
		</main>
		<Footer />
		<script is:inline>
			function loadShareThisWhenIdle() {
				var load = function () {
					if (document.querySelector('script[data-sharethis-loader]')) return;
					var script = document.createElement('script');
					script.async = true;
					script.src = 'https://platform-api.sharethis.com/js/sharethis.js#property=6aff304a4f0675cfbe033e69&product=sop';
					script.setAttribute('data-sharethis-loader', 'true');
					(document.head || document.body).appendChild(script);
				};
				if ('requestIdleCallback' in window) {
					window.requestIdleCallback(load, { timeout: 5000 });
				} else {
					window.setTimeout(load, 2500);
				}
			}
			window.addEventListener('load', loadShareThisWhenIdle, { once: true });
		</script>
	</body>
</html>

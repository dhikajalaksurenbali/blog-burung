		</a>
	</div>

	<div class="histats-info">
		<div id="histats_counter"></div>
		<noscript><a href="/" target="_blank"><img src="//sstatic1.histats.com/0.gif?5065099&101" alt="free counter statistics" border="0"></a></noscript>
	</div>
</footer>

<script is:inline>
	function scheduleHistats() {
		var started = false;
		var timer;

		function loadHistats() {
			if (started) return;
			started = true;
			window.clearTimeout(timer);
			window.removeEventListener('scroll', onScroll);

			var _Hasync = window._Hasync = window._Hasync || [];
			_Hasync.push(['Histats.start', '1,5065099,4,1041,200,30,00011000']);
			_Hasync.push(['Histats.fasi', '1']);
			_Hasync.push(['Histats.track_hits', '']);

			var histatsScript = document.createElement('script');
			histatsScript.type = 'text/javascript';
			histatsScript.async = true;
			histatsScript.src = 'https://s10.histats.com/js15_as.js';
			(document.head || document.body).appendChild(histatsScript);
		}

		function onScroll() {
			if (window.scrollY > 0) loadHistats();
		}

		function startDelay() {
			if (started) return;
			timer = window.setTimeout(loadHistats, 8000);
		}

		window.addEventListener('scroll', onScroll, { passive: true });

		if (document.readyState === 'complete') {
			startDelay();
		} else {
			window.addEventListener('load', startDelay, { once: true });
		}
	}

	scheduleHistats();
</script>

<style>
	footer {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		align-items: center;
		gap: 1rem;
		padding: 30px;
		background: linear-gradient(to bottom, #159957, #155799);
		color: #ffffff;
	}

	.footer-credit {
		text-align: left;
	}

	.social-links {
		display: flex;
		justify-content: center;
		align-items: center;
		gap: 1em;
		margin: 0;
	}

	.social-links a {
		display: flex;
		text-decoration: none;
		color: #ffffff;
	}

	.social-links a:hover {
		color: #ffc107;
	}

	.histats-info {
		text-align: right;
	}

	a.copy-links {
		text-decoration: none;
		color: #ffffff;
	}

	a.copy-links:hover {
		text-decoration: underline;
		text-underline-offset: 3px;
	}

	@media (max-width: 720px) {
		footer {
			grid-template-columns: 1fr;
			justify-items: center;
			gap: 1.25rem;
			text-align: center;
		}

		.footer-credit,
		.histats-info {
			text-align: center;
		}

		.social-links {
			order: 0;
		}

		.footer-credit {
			order: -1;
		}
	}
</style>
